{
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "parche" }], "destination": "/api/share" }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
